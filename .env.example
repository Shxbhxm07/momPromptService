# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# On the cluster none of this lives in a file: the values come from an OpenShift Secret,
# and the topic and endpoint names come from the Deployment. This file is local only.

# ── the minutes writer ───────────────────────────────────────────────────────
# Required. The key llama-service sends as "Authorization: Bearer <key>".
# Get one at https://openrouter.ai/keys. Rotate it if it is ever pasted anywhere.
OPENROUTER_API_KEY=

# Optional. Point at an llama-service that is already running instead of starting one:
#   LLAMA_URL=http://some-other-llama:8001
# then bring the stack up with:  docker compose up -d --scale llama=0
# LLAMA_URL=
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# ── local storage (defaults are fine) ────────────────────────────────────────
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=mom

# ── ports on your machine (change only if something else uses them) ──────────
# SERVICE_PORT=8010
# LLAMA_PORT=8011
# KAFKA_UI_PORT=8090
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# ELASTIC_PORT=9200
# KAFKA_HOST_PORT=29092
