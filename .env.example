# Copy to .env and fill in. .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# On the cluster none of this lives in a file: the values come from an OpenShift Secret,
# and the topic and endpoint names come from the Deployment. This file is local only.

# ── the minutes writer ───────────────────────────────────────────────────────
# Required. The key the minutes writer (inside the service) sends as "Authorization: Bearer <key>".
# Get one at https://openrouter.ai/keys. Rotate it if it is ever pasted anywhere.
OPENROUTER_API_KEY=

# Optional. The model, as OpenRouter names it.
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# ── local storage (defaults are fine) ────────────────────────────────────────
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=mom

# ── ports on your machine (change only if something else uses them) ──────────
# SERVICE_PORT=8010
# KAFKA_UI_PORT=8090
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# ELASTIC_PORT=9200
# KAFKA_HOST_PORT=29092
