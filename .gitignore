# ── secrets ──────────────────────────────────────────────────────────────────
# MinIO and Elasticsearch credentials and the watsonx key live in OpenShift Secrets,
# never in this repo. .env is for local runs only and is never committed.
.env
*.pem
*.key
secrets.env

# ── python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ── local data & generated output ────────────────────────────────────────────
# Test documents and the minutes made from them are inputs/outputs, not source.
*.pdf
*.doc
*.docx
!docs/**/*.pdf
out/
*_report.docx
# samples/ is the exception: small text fixtures for testing are source, not output.
!samples/*.txt
# templates/ is the test pack handed to the testing team: the specimen minutes are deliverables.
!templates/*.docx
# The minutes are filled into this template (app/minutes_template.py): without it in the image every job
# falls back to the code-built layout, silently.
!app/templates/*.docx

# ── editor / OS ──────────────────────────────────────────────────────────────
# LibreOffice / Microsoft Office lock files, created while a document is open.
.~lock.*#
~$*
.DS_Store
.idea/
.vscode/
*.swp

# LibreOffice/fontconfig cache, written when .doc is converted during a test — machine-specific.
**/.cache/
